# GitLab self-hosted (API v4). Ex.: https://gitlab.suaempresa.local
GITLAB_BASE_URL=

# Token com permissão de leitura das issues (header PRIVATE-TOKEN no servidor).
GITLAB_TOKEN=

# Modo mock (não chama GitLab; útil para UI/dev sem credenciais).
# GITLAB_MOCK=1

# TLS com certificado interno/self-signed (só desenvolvimento local — NUNCA em produção).
# Preferível: exportar a CA e usar no shell antes do npm run dev:
#   PowerShell: $env:NODE_EXTRA_CA_CERTS="C:\caminho\para\ca-empresa.pem"
# Alternativa (menos segura): ignorar verificação TLS só nesta rota:
# GITLAB_TLS_INSECURE_DEV=1

# Triagem (lista no grupo, inclui subprojetos): issues abertas com label
GITLAB_TRIAGE_GROUP_PATH=portal-da-defensoria
GITLAB_TRIAGE_LABEL=Triagem de issues

# Matriz DVITU (priorização no card): exige no issue todas as labels de `GITLAB_TRIAGE_LABEL` (CSV) + esta label.
# GITLAB_DVITU_ELIGIBILITY_MELHORIA_LABEL=Melhoria
# Label aplicada após submeter (crie no GitLab com este nome). Padrão: DVITU
# GITLAB_DVITU_APPLIED_LABEL_NAME=DVITU
# O token precisa poder editar issues (PUT), não só ler.

# Matriz GUT (priorização no card): exige no issue todas as labels de `GITLAB_TRIAGE_LABEL` (CSV) + esta label (match ignora maiúsculas).
# GITLAB_GUT_ELIGIBILITY_BUG_LABEL=Bug
# Label aplicada após submeter (crie no GitLab com este nome). Padrão: GUT
# GITLAB_GUT_APPLIED_LABEL_NAME=GUT

# Projeto onde o modal "Criar no GitLab" chama POST /api/v4/projects/:id/issues (path completo, ex.: grupo/portal-defensoria-gateway)
GITLAB_CREATE_ISSUE_PROJECT_PATH=portal-da-defensoria/portal-defensoria-gateway

# Labels aplicadas na criação (nomes separados por vírgula; vazio = não envia labels). Padrão: squad::bravo
GITLAB_CREATE_ISSUE_DEFAULT_LABELS=squad::bravo

# Handoff SmartTask → Tina (`window.postMessage`): origens HTTP autorizadas (várias separadas por vírgula).
# Em dev, se vazio, aceita localhost / 127.0.0.1 / ::1 na porta 3000.
# NEXT_PUBLIC_SMARTTASK_HANDOFF_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Modo visualização (produção / viewer): quadro congelado na UI; bloqueia APIs GitLab/SmartTask mutáveis
# e proxies de imagem. Mantém GET do quadro e assets já espelhados em data/.
# PUT (Importar) exige WISH_VIEW_ONLY_BOARD_IMPORT_API_KEY (Bearer). Fail-closed se a key estiver vazia.
# Em local, sem esta flag, use o toggle "Prévia produção" na toolbar (só UI, sessionStorage).
# WISH_VIEW_ONLY_MODE=1
# WISH_VIEW_ONLY_BOARD_IMPORT_API_KEY=gere-uma-chave-longa-e-secreta

# Portão de acesso (separado da chave de import): se definido, exige secret em /entrar
# (cookie HttpOnly) antes de ver o quadro / APIs. Em local, deixe vazio.
# WISH_APP_ACCESS_SECRET=gere-outro-segredo-longo-diferente-da-chave-de-import

# Editor local → publicar no viewer de produção (botão "Publicar na VPS").
# A chave deve ser a mesma WISH_VIEW_ONLY_BOARD_IMPORT_API_KEY do viewer.
# NÃO defina isso no container da VPS (só no .env.local do editor).
# WISH_PRODUCTION_VIEWER_BASE_URL=https://sua-tina-na-vps.exemplo
# WISH_PRODUCTION_VIEWER_IMPORT_API_KEY=mesma-chave-de-import-do-viewer

# Viewer em produção: NÃO defina GITLAB_TOKEN, GITLAB_MOCK, GITLAB_TLS_INSECURE_DEV nem SMARTTASK_*.
# Monte volume persistente em data/ (triage.db + gitlab-description-uploaded-assets-v1/).
